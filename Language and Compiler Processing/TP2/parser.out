    ELSE            reduce using rule 26 (Selecao -> IF Condicao DOISPT Corpo ELSE DOISPT Corpo ENDELSE ENDIF .)
    ENDWHILE        reduce using rule 26 (Selecao -> IF Condicao DOISPT Corpo ELSE DOISPT Corpo ENDELSE ENDIF .)
    RETURN          reduce using rule 26 (Selecao -> IF Condicao DOISPT Corpo ELSE DOISPT Corpo ENDELSE ENDIF .)
    ENDELSE         reduce using rule 26 (Selecao -> IF Condicao DOISPT Corpo ELSE DOISPT Corpo ENDELSE ENDIF .)

